# Copy to .env (git-ignored) and fill in. Add each new service's vars here next to the script that needs them.

# Cloudinary — Dashboard > Settings > API Keys > "API environment variable".
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# The cloud name here is also the Frontend's VITE_CLOUDINARY_CLOUD_NAME.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
